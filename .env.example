GOOGLE_API_KEY=your-gemini-api-key

# Optional model override. Default used by the agent:
# google/gemini-2.0-flash
ASO_AGENT_MODEL=

# Optional OpenAI-compatible fallback (e.g., NVIDIA NIM/OpenAI).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: if you want to enrich scraping via Firecrawl in the future.
FIRECRAWL_API_KEY=
